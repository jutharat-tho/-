@startuml flow-feChangePassword
!theme plain
skinparam backgroundColor #FAFAFA
skinparam ActivityBackgroundColor #E8F4FD
skinparam ActivityBorderColor #2C5F8A
skinparam ActivityDiamondBackgroundColor #FFF9C4
skinparam ActivityDiamondBorderColor #F0C000
skinparam ArrowColor #444444
skinparam NoteBackgroundColor #FFF9C4
skinparam NoteBorderColor #F0C000

title <b>FE Flow — หน้า Change Password</b>\n<i>Vue 3 + Vuelidate | รองรับ 2 triggers: first_time | expired</i>

start

:User เข้าหน้า <b>/change-password?mode={mode}</b>;

note right #FFF9C4
  <b>mode (query string) ↔ trigger (JWT claim):</b>
  • <b>first-time</b> → trigger=first_time (Case 1: Temp password)
  • <b>expired</b>    → trigger=expired (Case 3: รหัสหมดอายุ 90 วัน)
end note

:Read accessToken จาก store / memory;

if (มี accessToken?) then (ไม่มี)
  #FADBD8:Redirect → /login;
  stop
endif

:Parse JWT → อ่าน claims\n{ scope, trigger };

if (scope ∈ "FULL" / "CHANGE_PASSWORD"?) then (ไม่ใช่)
  #FADBD8:Toast "Session ไม่ถูกต้อง"\nClear tokens → Redirect /login;
  stop
endif

if (trigger == "first_time"?) then (ใช่)
  :Render form แบบ <b>2 fields</b>:\n• password\n• confirmPassword;
  note right #E8F4FD
    Case 1 (Temp Password):
    <b>ไม่มี</b> field <i>oldPassword</i>
    เพราะ user login ด้วย
    temp password อยู่แล้ว
  end note
else (expired)
  :Render form แบบ <b>3 fields</b>:\n• oldPassword\n• password\n• confirmPassword;
endif

:แสดง <b>Rule Card "รหัสผ่านใหม่"</b>\n(6 rules — live checklist);

note right #FFF9C4
  <b>State สีของ Card:</b>
  ⚪ <b>empty</b>   → ครีม/เหลือง
  ❌ <b>partial</b> → แดงพาสเทล
  ✅ <b>all pass</b> → เขียวพาสเทล
end note

repeat :User พิมพ์ใน field password / confirmPassword;

  :Validate ตรวจ <b>6 rules</b> real-time;

  note right #FFF9C4
    <b>Live checks ใน Card:</b>
    1. length      → 8-20 ตัวอักษร
    2. upper       → [A-Z] อย่างน้อย 1
    3. lower       → [a-z] อย่างน้อย 1
    4. digit       → [0-9] อย่างน้อย 1
    5. special     → . ! @ # $ % ^ * _ - +
    6. match       → confirm ตรงกับ password
  end note

  :อัปเดต icon (❌ / ✅) ของแต่ละ rule\nอัปเดต border color ของ Card;

repeat while (User กด "ยืนยัน"?) is (ยังไม่กด) not (กดแล้ว)

if (ผ่านครบ 6 rules?) then (ไม่)
  :Highlight rule ที่ไม่ผ่าน (❌ แดง)\nButton "ยืนยัน" ไม่ submit;
  note right #FFE0E0
    ไม่ call API
    รอ user แก้แล้วกดใหม่
  end note
  stop
endif

:Build request body:;

if (trigger == "first_time"?) then (ใช่)
  :body = { newPassword };
else (expired)
  :body = { oldPassword, newPassword };
endif

:<b>POST</b> /auth/change-password\n<font color=gray>Authorization: Bearer {accessToken}</font>;

:รอ response;

switch (HTTP code)

case ( <b>200</b> )
  #D5F5E3:Toast "ตั้งรหัสผ่านสำเร็จ";
  :Clear tokens จาก store;
  :Redirect → /login;
  note right #D5F5E3
    Backend revoke ทุก session อยู่แล้ว
    FE บังคับ re-login ด้วยรหัสใหม่
  end note
  stop

case ( <b>400 (2003)</b>\nwrong_old_password )
  #FADBD8:Highlight <b>oldPassword</b> field (กรอบแดง)\nHelper text: "รหัสผ่านเดิมไม่ถูกต้อง";
  note right #FFE0E0
    เฉพาะ trigger=expired
    (first_time ไม่เข้ากรณีนี้)
  end note
  stop

case ( <b>400 (2012)</b>\nsame_password_as_temp )
  #FADBD8:แสดง <b>Popup</b>:\n"ไม่สามารถตั้งรหัสผ่านได้\nเนื่องจากรหัสผ่านใหม่ไม่สามารถ\nซ้ำกับรหัสผ่านชั่วคราวได้\nกรุณากำหนดรหัสผ่านใหม่อีกครั้ง"\nปุ่ม: [ตั้งรหัสผ่านใหม่] → ปิด popup + clear field;
  note right #FFE0E0
    Hit บ่อยใน trigger=first_time
    เพราะ user จำ temp password ได้
    แล้วเผลอตั้งใหม่ซ้ำ
  end note
  stop

case ( <b>400 (2004)</b>\nsame_password )
  #FADBD8:Helper text ใต้ field password:\n"รหัสผ่านใหม่ต้องไม่เหมือนรหัสผ่านเดิม";
  note right #FFE0E0
    เฉพาะ trigger=expired
    (กรณี user มี passwordHash อยู่แล้ว
    ตั้งใหม่ตรงกับเดิม)
  end note
  stop

case ( <b>400 (2005)</b>\nweak_password )
  #FADBD8:Highlight rule ที่ไม่ผ่านใน Card;
  note right #FFE0E0
    Fallback case —
    ปกติ FE block ไว้ตั้งแต่ขั้น
    Vuelidate แล้ว
  end note
  stop

case ( <b>400 (2011)</b>\npassword_reuse )
  #FADBD8:Helper text ใต้ field password:\n"รหัสผ่านใหม่ต้องไม่ซ้ำกับรหัสผ่านล่าสุด";
  stop

case ( <b>401 (1001/1002/1003)</b>\nUnauthorized / Token issue )
  #FADBD8:Toast "Session หมดอายุ กรุณา login ใหม่"\nClear tokens → Redirect /login;
  stop

case ( <b>403 (2010)</b>\nTokenScope )
  #FADBD8:Toast "Session ไม่มีสิทธิ์เปลี่ยนรหัสผ่าน"\nClear tokens → Redirect /login;
  stop

case ( <b>500 / network</b> )
  #FADBD8:Toast "เกิดข้อผิดพลาด กรุณาลองใหม่อีกครั้ง"\nคง field + token ไว้;
  stop

endswitch

@enduml
