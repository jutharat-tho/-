@startuml flow-authChangePassword
!theme plain
skinparam backgroundColor #FAFAFA
skinparam ActivityBackgroundColor #E8F4FD
skinparam ActivityBorderColor #2C5F8A
skinparam ActivityDiamondBackgroundColor #FFF9C4
skinparam ActivityDiamondBorderColor #F0C000
skinparam ArrowColor #444444
skinparam NoteBackgroundColor #FFF9C4
skinparam NoteBorderColor #F0C000

title <b>POST /auth/change-password</b>\n<i>รองรับ 2 triggers: first_time | expired</i>

start

:Client ส่ง <b>POST</b> /auth/change-password\n<font color=gray>Authorization: Bearer {token}\n{ newPassword }</font>;

note right #FFF9C4
  <b>Trigger จาก JWT claim (ใช้สำหรับ audit + side-effect):</b>
  • <b>first_time</b> → Case 1 (จาก /auth/login ด้วย temp password)
  • <b>expired</b> → Case 3 (Password หมดอายุ 90 วัน)
end note

if (มี Authorization Bearer?) then (ไม่มี)
  #FADBD8:<b>401 (1001)</b> Unauthorized;
  stop
endif

:Parse + verify JWT signature;

if (Token valid?) then (ไม่)
  #FADBD8:<b>401 (1002)</b> Invalid Token;
  stop
endif

:Redis GET token_blacklist:jti;

if (อยู่ใน blacklist?) then (ใช่)
  #FADBD8:<b>401 (1002)</b> Token Revoked;
  stop
endif

if (scope = "FULL" / "CHANGE_PASSWORD"?) then (ไม่ใช่)
  #FADBD8:<b>403 (2010)</b> Insufficient token scope;
  stop
endif

:Validate body: { newPassword };

if (Validate ผ่าน?) then (ไม่)
  #FADBD8:<b>400 (1008)</b> Validation Failed;
  stop
endif

:MongoDB findOne: users { _id };

note right #FCF3CF
  <b>ไม่ verify oldPassword</b>
  Trust JWT token ทั้ง 3 cases
  (trigger ใช้สำหรับ audit log เท่านั้น)
end note

if (newPassword ตรงกับ passwordHash?) then (ตรง)
  #FADBD8:<b>400 (2004)</b> Same as current password;
  stop
endif

' :bcrypt.Compare(previousPasswordHash, newPassword);

' if (newPassword ตรงกับ previousPasswordHash?) then (ตรง)
'   #FADBD8:<b>400 (2011)</b> Password reuse;
'   note right #FFE0E0
'     Password ใหม่ต้องไม่ซ้ำ
'     กับ password ล่าสุด (1 ตัว)
'   end note
'   stop
' endif

:Validate complexity rules;
note right #FFF9C4
  • ความยาว >= 8 ตัวอักษร
  • uppercase + lowercase + digit
  • special character (@$!%*?&)
end note

if (ผ่าน complexity?) then (ไม่)
  #FADBD8:<b>400 (2005)</b> Weak Password;
  stop
endif

:hash newPassword (bcrypt cost 12);

:MongoDB UPDATE users SET\npasswordHash = newHash,\npasswordChangedAt = NOW,\npasswordExpiresAt = NOW + 90d,\n<b>isTempPassword = false,</b>\n<b>tempPasswordHash = null,</b>\n<b>tempPasswordExpiresAt = null</b>;

:Redis: SCAN + DEL refresh_token:userId:*\n(revoke ทุก session);
:Redis SET token_blacklist:currentJti\nEX ttlRemaining;

:Audit log: PASSWORD_CHANGED\n{ trigger };

#D5F5E3:<b>200</b> OK\nPassword changed successfully\n{ passwordChangedAt, passwordExpiresAt,\nrequireReLogin: true };

note right #D5F5E3
  Frontend:
  • Clear tokens จาก storage
  • Redirect → /login
  ➜ บังคับ re-login ด้วยรหัสใหม่
end note

stop

@enduml
